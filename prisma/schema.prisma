generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Community {
  id          Int               @id @default(autoincrement())
  slug        String            @unique
  name        String
  type        String
  icon        String
  image       String
  description String
  members     Int               @default(0)
  discord     String
  roblox      String?
  about       String
  staff       Json?
  createdAt   DateTime          @default(now())
  discordId   String?
  reviews     CommunityReview[]
  games       Game[]
}

model CommunityReview {
  id          Int          @id @default(autoincrement())
  communityId Int
  userId      Int
  rating      Int
  comment     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  status      ReviewStatus @default(PENDING)
  community   Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
  @@index([status])
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  content   String
  image     String?
  published Boolean  @default(false)
  authorId  Int?
  createdAt DateTime @default(now())
  author    User?    @relation(fields: [authorId], references: [id])
}

model Event {
  id           Int                @id @default(autoincrement())
  title        String
  slug         String             @unique
  description  String
  image        String?
  date         String
  time         String
  discord      String?
  published    Boolean            @default(false)
  createdAt    DateTime           @default(now())
  participants EventParticipant[]
}

model EventParticipant {
  id       Int      @id @default(autoincrement())
  eventId  Int
  userId   Int
  joinedAt DateTime @default(now())
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String
  image       String?
  platform    String
  status      String
  url         String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Game {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String
  image       String?
  platform    String
  link        String?
  featured    Boolean    @default(false)
  communityId Int?
  createdAt   DateTime   @default(now())
  community   Community? @relation(fields: [communityId], references: [id])
}

model Developer {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  role        String
  icon        String
  description String
  image       String?
  github      String?
  createdAt   DateTime @default(now())
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model User {
  id        Int      @id @default(autoincrement())
  discordId String?  @unique
  robloxId  String?  @unique
  email     String?  @unique
  password  String?
  emailVerified DateTime?

  username  String
  image     String?
  bio       String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())
  banner    String?
  discord   String?
  github    String?
  roblox    String?
  theme     String   @default("default")
  twitter   String?
  youtube   String?
  emailVerificationTokens EmailVerificationToken[]

  warnings    Int       @default(0)
  muted       Boolean   @default(false)
  mutedUntil  DateTime?
  banned      Boolean   @default(false)
  bannedUntil DateTime?
  banReason   String?

  logs                AuditLog[]
  badgeProgress       BadgeProgress[]
  communityReviews    CommunityReview[]
  eventParticipations EventParticipant[]
  following           Follow[]           @relation("Following")
  followers           Follow[]           @relation("Followers")
  news                News[]
  supportMessages     SupportMessage[]
  supportTickets      SupportTicket[]
  awardedBadges       UserBadge[]        @relation("AwardedBadges")
  badges              UserBadge[]        @relation("UserBadges")
  chatMessages        ChatMessage[]
  issuedWarnings      UserWarning[]      @relation("IssuedWarnings")
  warningsReceived    UserWarning[]      @relation("UserWarnings")

  issuedMutes   UserMute[] @relation("IssuedMutes")
  mutesReceived UserMute[] @relation("UserMutes")

  issuedBans   UserBan[] @relation("IssuedBans")
  bansReceived UserBan[] @relation("UserBans")
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Badge {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  slug        String          @unique
  icon        String
  description String
  createdAt   DateTime        @default(now())
  category    String          @default("Special/Role")
  isSecret    Boolean         @default(false)
  requirement String?
  target      Int?
  progress    BadgeProgress[]
  users       UserBadge[]
}

model UserBadge {
  id          Int      @id @default(autoincrement())
  userId      Int
  badgeId     Int
  awardedById Int?
  awardedAt   DateTime @default(now())
  awardedBy   User?    @relation("AwardedBadges", fields: [awardedById], references: [id])
  badge       Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user        User     @relation("UserBadges", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@index([awardedById])
}

model BadgeProgress {
  id        Int      @id @default(autoincrement())
  userId    Int
  badgeId   Int
  progress  Int      @default(0)
  updatedAt DateTime @updatedAt
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  target    String
  details   String
  userId    Int?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model SiteSettings {
  id          Int      @id @default(1)
  siteName    String   @default("Nexus")
  description String?
  logo        String?
  favicon     String?
  discord     String?
  github      String?
  youtube     String?
  maintenance Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model SupportTicket {
  id        Int              @id @default(autoincrement())
  userId    Int?
  subject   String
  category  String
  status    String           @default("OPEN")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deleted   Boolean          @default(false)
  deletedAt DateTime?
  deletedBy String?
  messages  SupportMessage[]
  user      User?            @relation(fields: [userId], references: [id])
}

model SupportMessage {
  id        Int           @id @default(autoincrement())
  ticketId  Int
  senderId  Int?
  message   String
  createdAt DateTime      @default(now())
  sender    User?         @relation(fields: [senderId], references: [id])
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Partner {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  slug        String        @unique
  logo        String
  banner      String?
  description String
  discord     String?
  roblox      String?
  website     String?
  featured    Boolean       @default(false)
  verified    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tier        String        @default("Official")
  email       String
  members     Int           @default(0)
  ownerName   String
  reason      String
  socials     String?
  status      PartnerStatus @default(PENDING)
  discordId   String?
}

model HallOfFame {
  id          Int      @id @default(autoincrement())
  name        String
  title       String
  category    String
  description String
  image       String?
  year        String?
  createdAt   DateTime @default(now())
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  replyToId Int?
  replyTo   ChatMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("MessageReplies")

  @@index([userId])
  @@index([createdAt])
  @@index([replyToId])
}

model UserWarning {
  id          Int      @id @default(autoincrement())
  userId      Int
  moderatorId Int
  reason      String
  createdAt   DateTime @default(now())

  user      User @relation("UserWarnings", fields: [userId], references: [id], onDelete: Cascade)
  moderator User @relation("IssuedWarnings", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([moderatorId])
  @@index([createdAt])
}

model UserMute {
  id          Int       @id @default(autoincrement())
  userId      Int
  moderatorId Int
  reason      String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  user      User @relation("UserMutes", fields: [userId], references: [id], onDelete: Cascade)
  moderator User @relation("IssuedMutes", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([moderatorId])
  @@index([createdAt])
  @@index([expiresAt])
}

model UserBan {
  id          Int       @id @default(autoincrement())
  userId      Int
  moderatorId Int
  reason      String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  user      User @relation("UserBans", fields: [userId], references: [id], onDelete: Cascade)
  moderator User @relation("IssuedBans", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([moderatorId])
  @@index([createdAt])
  @@index([expiresAt])
}
