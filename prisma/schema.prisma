generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Community {
  id          Int               @id @default(autoincrement())
  slug        String            @unique
  name        String
  type        String
  icon        String
  image       String
  description String
  members     Int               @default(0)
  discord     String
  roblox      String?
  about       String
  staff       Json?
  createdAt   DateTime          @default(now())
  discordId   String?
  games       Game[]
  reviews     CommunityReview[]
}

model CommunityReview {
  id          Int          @id @default(autoincrement())
  communityId Int
  userId      Int
  rating      Int
  comment     String
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
  @@index([status])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  content   String
  image     String?
  published Boolean  @default(false)
  authorId  Int?
  createdAt DateTime @default(now())
  author    User?    @relation(fields: [authorId], references: [id])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String
  image       String?
  date        String
  time        String
  discord     String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String
  image       String?
  platform    String
  status      String
  url         String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Game {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String
  image       String?
  platform    String
  link        String?
  featured    Boolean    @default(false)
  communityId Int?
  createdAt   DateTime   @default(now())
  community   Community? @relation(fields: [communityId], references: [id])
}

model Developer {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  role        String
  icon        String
  description String
  image       String?
  github      String?
  createdAt   DateTime @default(now())
}

model User {
  id               Int               @id @default(autoincrement())
  discordId        String            @unique
  username         String
  image            String?
  bio              String?
  role             String            @default("USER")
  createdAt        DateTime          @default(now())
  logs             AuditLog[]
  news             News[]
  supportMessages  SupportMessage[]
  supportTickets   SupportTicket[]
  awardedBadges    UserBadge[]       @relation("AwardedBadges")
  badges           UserBadge[]       @relation("UserBadges")
  communityReviews CommunityReview[]
}

model Badge {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  slug        String      @unique
  icon        String
  description String
  category    String      @default("Special/Role")
  createdAt   DateTime    @default(now())
  users       UserBadge[]
}

model UserBadge {
  id          Int      @id @default(autoincrement())
  userId      Int
  badgeId     Int
  awardedById Int?
  awardedAt   DateTime @default(now())
  awardedBy   User?    @relation("AwardedBadges", fields: [awardedById], references: [id])
  badge       Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user        User     @relation("UserBadges", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@index([awardedById])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  target    String
  details   String
  userId    Int?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model SiteSettings {
  id          Int      @id @default(1)
  siteName    String   @default("Nexus")
  description String?
  logo        String?
  favicon     String?
  discord     String?
  github      String?
  youtube     String?
  maintenance Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model SupportTicket {
  id        Int              @id @default(autoincrement())
  userId    Int?
  subject   String
  category  String
  status    String           @default("OPEN")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deleted   Boolean          @default(false)
  deletedAt DateTime?
  deletedBy String?
  messages  SupportMessage[]
  user      User?            @relation(fields: [userId], references: [id])
}

model SupportMessage {
  id        Int           @id @default(autoincrement())
  ticketId  Int
  senderId  Int?
  message   String
  createdAt DateTime      @default(now())
  sender    User?         @relation(fields: [senderId], references: [id])
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Partner {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  slug        String        @unique
  logo        String
  banner      String?
  description String
  discord     String?
  roblox      String?
  website     String?
  featured    Boolean       @default(false)
  verified    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tier        String        @default("Official")
  email       String
  members     Int           @default(0)
  ownerName   String
  reason      String
  socials     String?
  status      PartnerStatus @default(PENDING)
  discordId   String?
}

model HallOfFame {
  id          Int      @id @default(autoincrement())
  name        String
  title       String
  category    String
  description String
  image       String?
  year        String?
  createdAt   DateTime @default(now())
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
}
